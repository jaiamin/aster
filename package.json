{
  "name": "aster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev & cd apps/api && uv run uvicorn app.main:app --port 8000 --reload",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --port 8000 --reload",
    "dev:web": "cd apps/web && pnpm dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.6.2",
  "devDependencies": {
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
